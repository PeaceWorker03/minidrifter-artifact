{
  "packages_root": "auto",
  "data_root": "./Data",
  "raw_dir": "_raw",
  "report_dir": "_reports",
  "categories": [
    "餐饮、生活消费",
    "房产与生活服务",
    "交通出行、租车服务",
    "景区、票务与预约",
    "企业与办公服务",
    "商城与零售",
    "校园与教育",
    "医疗与健康服务",
    "政务、缴费及其他服务"
  ],
  "wedecode_cmd": "wedecode",
  "wedecode_timeout_sec": 600,
  "wedecode_output_stable_sec": 12,
  "wedecode_idle_kill_sec": 45,
  "wedecode_proc_wait_sec": 15,
  "confidence_threshold": 0.22,
  "ambiguity_gap": 0.06,
  "identify_api": "https://kainy.cn/api/weapp/info/",
  "identify_timeout_sec": 2.5,
  "skip_remote_when_local_named": true,
  "workers": 12,
  "classify_max_total_bytes": 8000000,
  "registry_flush_every": 20,
  "processed_file": "_processed.json",
  "skip_bootstrap": false,
  "bootstrap_skip_if_count": 1,
  "force_bootstrap": false
}
